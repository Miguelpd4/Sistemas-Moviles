# Copia este fichero a .env (cp .env.example .env) en la carpeta desde la que compiláis.
# Todos los valores de aquí son PÚBLICOS: acaban dentro del APK y de la web. Nunca pongas aquí
# la clave service_role ni el Client secret de Spotify: viven solo en Supabase → Edge Functions → Secrets.
# Las variables EXPO_PUBLIC_* se meten en el APK al compilar: si cambias alguna, vuelve a compilar.

# Supabase → Project Settings → API (o la salida de `npx supabase start` en local)
EXPO_PUBLIC_SUPABASE_URL=https://dytieuiyvrsejwvcvirh.supabase.co
# Clave publicable (sb_publishable_...)
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_9UFYNcSgH3SPGTAdgTUmsQ_3nrgTkUj

# Dominio de la web en Vercel, sin barra final. Es el que va grabado en la pegatina NFC
# (https://<dominio>/c/<codigo_coche>) y el del App Link de Android. Obligatoria.
EXPO_PUBLIC_WEB_URL=https://copi-navy.vercel.app

# Client ID de la app COPI en Spotify for Developers (el conductor conecta su Spotify con él)
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=c19815817b97464a8cfa342144146592
