# Copia este fichero a .env y rellena los valores. Nunca subas .env al repositorio.
# Solo variables públicas (EXPO_PUBLIC_*): la clave service_role y los secretos de Spotify
# viven únicamente en las Edge Functions de Supabase.

# Supabase → Project Settings → API (o la salida de `npx supabase start` en local)
EXPO_PUBLIC_SUPABASE_URL=
# Clave publicable (sb_publishable_...) o la clave anon
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Dominio de la web en Vercel, sin barra final. Es el que va grabado en la pegatina NFC
# (https://<dominio>/c/<codigo_coche>) y el del App Link de Android. Obligatoria.
EXPO_PUBLIC_WEB_URL=https://copi-uco.vercel.app

# Client ID de la app de Spotify for Developers (solo para la prueba de Spotify, S1-09)
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=
